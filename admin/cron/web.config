<?xml version="1.0" encoding="UTF-8"?>
<!--
    admin/cron dizini web erisimine kapalidir.

    Merkezi cron sisteminde bu dizindeki hicbir dosyaya tarayicidan erisim gerekmez:
      - runner.php  -> Plesk "Komut calistir" ile CLI'dan
      - worker.php  -> CLI'dan
      - manuel tetik -> admin/pages/cron-yonetimi.php icindeki AJAX (oturum + PageAuth korumali)

    Onceden bu dizinde bir .htaccess vardi; Apache direktifleri icerdigi icin IIS uzerinde
    hicbir etkisi yoktu ve logs dizini web'den okunabilir durumdaydi.

    NOT: Ilk surumde <authorization><deny users="*" /> kullanilmisti; bu sunucuda IIS
    URL Authorization ozelligi kurulu olmadigi icin dizin 403 yerine 500 veriyordu.
    Ayni koruma Request Filtering ile saglaniyor - o modul IIS'te varsayilan kuruludur.
    hiddenSegments listesindeki her ad, hem alt dizin hem dosya adi olarak engellenir (404).

    Web tetigi gerekirse (Plesk "Fetch a URL" senaryosu) runner.php satiri listeden
    cikarilir; runner.php kendi anahtar kontrolunu (CronAyarlar.cron_secret_key) zaten yapar.
-->
<configuration>
    <system.webServer>

        <security>
            <requestFiltering>
                <hiddenSegments>
                    <!-- Alt dizinler -->
                    <add segment="logs" />
                    <add segment="gorevler" />

                    <!-- Cekirdek dosyalar: web'den cagrilmalari gerekmiyor -->
                    <add segment="runner.php" />
                    <add segment="worker.php" />
                    <add segment="tasks.php" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <directoryBrowse enabled="false" />

    </system.webServer>
</configuration>
